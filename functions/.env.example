# Copy this file to functions/.env and fill in real values.
# Firebase Functions (2nd gen) automatically loads functions/.env at deploy time.
# Use the SAME values you already use in your Vercel/Next.js .env for these two.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: protects the manual HTTP trigger
# (grantWeeklySubscriptionCreditsManual) with a shared secret.
CRON_SECRET=
