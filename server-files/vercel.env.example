# Next.js / Vercel proxy settings
HF_SPACE_URL=https://your-backend-domain.example
HF_INTERNAL_API_KEY=replace-with-a-long-random-server-key
# The exact same value must be configured in the Python backend.
# Customer API keys are managed dynamically in Firestore:
# api_keys/{customer_key} -> { userId, owner, disabled }

# Firebase server actions (one-line JSON)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id"}

# Storage used by the existing app
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=12labs
R2_PUBLIC_URL=https://storage.example.com
# Generated API audio/text is retained for this many days by the daily
# public-api/r2_cleanup.py job. Use DRY_RUN=1 before enabling deletion.
API_ARTIFACT_RETENTION_DAYS=7

# Optional HQ script backend settings
HQ_BACKEND_URL=https://your-backend-domain.example
HQ_ACCESS_KEY=replace-with-hq-key
HF_TOKEN=replace-with-huggingface-token